IO_PORT "tmds2_data_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds2_data_p[1]" F3;
IO_PORT "tmds2_data_p[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds2_data_n[1]" E3;
