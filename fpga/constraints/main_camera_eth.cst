// ---- HDMI 输出使能 ----
IO_LOC "hdmi1_oe" H5;
IO_PORT "hdmi1_oe" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hdmi2_oe" K2;
IO_PORT "hdmi2_oe" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// ---- 用户按键 S1（按下=重新开始计分，低有效）----
IO_LOC "key_restart" A20;
IO_PORT "key_restart" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// ---- 用户按键 S2（与 S1 并联，按下=重新开始计分）----
IO_LOC "key_restart2" B20;
IO_PORT "key_restart2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
