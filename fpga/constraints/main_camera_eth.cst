IO_LOC "fpga_uart_tx" M15;
IO_PORT "fpga_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// ---- 第二路 HDMI TMDS（板上第二个 HDMI 口）----
IO_LOC "tmds2_clk_p" H4;
IO_PORT "tmds2_clk_p" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds2_clk_n" G4;
IO_PORT "tmds2_clk_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
