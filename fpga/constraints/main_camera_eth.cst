// ---- RGMII 接收（新增）----
IO_LOC "rgmii_rxc" W19;
IO_PORT "rgmii_rxc" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "rgmii_rxdv" AB18;
IO_PORT "rgmii_rxdv" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
