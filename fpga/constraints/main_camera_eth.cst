//=============================================================================
// main_camera_eth.cst — 主通路：OV5640 DVP + RGMII 千兆网
// 管脚来源：ch59 官方例程（已上板验证）+ 通用管脚分配表交叉核对
// 注意：板上 LED0/LED1 的 M22/N22 在 60K 封装是 SSPI 专用脚，改用 L21/K21
//=============================================================================

IO_LOC "clk50m" Y18;
IO_PORT "clk50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "reset_n" F15;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- LED ----
IO_LOC "led[0]" L21;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" K21;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- OV5640 DVP ----
IO_LOC "camera_pwdn" L1;
IO_PORT "camera_pwdn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "camera_rst_n" N20;
IO_PORT "camera_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
