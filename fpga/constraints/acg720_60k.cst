//=============================================================================
// acg720_60k.cst — 小梅哥 ACG720 (GW5AT-LV60PG484) 物理约束
// 管脚来源：04_引脚功能信息/高云 ACG720-138&60K通用管脚分配表.xlsx
//          并经 ch47 官方例程 .cst 交叉核对
// 注意：本文件只含当前顶层已存在的端口；新增模块时再逐条补充
//=============================================================================

// ---- 系统 ----
IO_LOC "clk50M" Y18;
IO_PORT "clk50M" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "reset_n" F15;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- LED ----
// 注：60K 封装的 M22/N22 是 SSPI 专用脚，板上 LED0/LED1 在 60K 上不可用，
//     这里改用 L21 / K21 两颗（对应板上 LED2/LED3）
IO_LOC "led[0]" L21;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" K21;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- HDMI1 (FPGA 直接输出 TMDS 差分对) ----
IO_LOC "tmds_clk_p" K4;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_n" J4;
IO_PORT "tmds_clk_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[0]" L3;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_n[0]" K3;
IO_PORT "tmds_data_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[1]" L5;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_n[1]" L4;
IO_PORT "tmds_data_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[2]" M3;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_n[2]" M2;
IO_PORT "tmds_data_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- TFT 800x480 RGB565 ----
IO_LOC "tft_clk" AB20;
IO_PORT "tft_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_de" AB22;
IO_PORT "tft_de" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_hs" V19;
IO_PORT "tft_hs" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_vs" Y19;
IO_PORT "tft_vs" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_pwm" AB21;
IO_PORT "tft_pwm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "tft_rgb[15]" U17;
IO_PORT "tft_rgb[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[14]" U18;
IO_PORT "tft_rgb[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[13]" P14;
IO_PORT "tft_rgb[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[12]" R14;
IO_PORT "tft_rgb[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[11]" R18;
IO_PORT "tft_rgb[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[10]" T18;
IO_PORT "tft_rgb[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[9]" N17;
IO_PORT "tft_rgb[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[8]" P17;
IO_PORT "tft_rgb[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[7]" P15;
IO_PORT "tft_rgb[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[6]" R16;
IO_PORT "tft_rgb[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[5]" N13;
IO_PORT "tft_rgb[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[4]" N14;
IO_PORT "tft_rgb[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[3]" P16;
IO_PORT "tft_rgb[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[2]" R17;
IO_PORT "tft_rgb[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[1]" N15;
IO_PORT "tft_rgb[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tft_rgb[0]" L6;
IO_PORT "tft_rgb[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- 时序约束（时钟走 .sdc，见下）----
// create_clock -name clk50M -period 20 [get_ports {clk50M}]
